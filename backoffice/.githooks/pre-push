#!/bin/sh
# pre-push del backoffice — corre `npm run check` (typecheck + lint + estilos + estructura + madge +
# tests headless + build + bundle) SOLO si lo que se pushea toca backoffice/. Minutos.
# Git pasa por stdin una línea por ref: <ref local> <sha local> <ref remoto> <sha remoto>.
# Activar: `npm run hooks:install` (en backoffice/). Saltear una vez: `git push --no-verify`.

REMOTO="$1"
CERO=0000000000000000000000000000000000000000
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

toca=0
while read -r _ref_local sha_local _ref_remoto sha_remoto; do
  [ -z "$sha_local" ] && continue
  [ "$sha_local" = "$CERO" ] && continue # borrado de rama
  if [ "$sha_remoto" = "$CERO" ]; then
    # rama nueva: commits que el remoto todavía no tiene
    cambios=$(git rev-list -n 1 "$sha_local" --not --remotes="$REMOTO" -- backoffice 2>/dev/null)
  else
    cambios=$(git diff --name-only "$sha_remoto" "$sha_local" -- backoffice 2>/dev/null | head -n 1)
  fi
  [ -n "$cambios" ] && toca=1
done

[ "$toca" -eq 1 ] || exit 0

cd "$ROOT/backoffice" 2>/dev/null || exit 0
command -v npm >/dev/null 2>&1 || { echo "[pre-push] npm no está en el PATH: se saltea 'npm run check'." >&2; exit 0; }
[ -d node_modules ] || { echo "[pre-push] backoffice/node_modules no existe (corré npm ci): se saltea 'npm run check'." >&2; exit 0; }

echo "[pre-push] El push toca backoffice/: corriendo 'npm run check'…" >&2
# stdin del hook ya se consumió; npm no debe heredar un stdin raro.
npm run check </dev/null || {
  echo "[pre-push] 'npm run check' falló: no se pushea. Corregilo (o 'git push --no-verify' bajo tu responsabilidad)." >&2
  exit 1
}
exit 0
