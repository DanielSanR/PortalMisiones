{
  "name": "backoffice",
  "version": "0.0.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:staging": "ng serve --configuration staging",
    "start:local": "ng serve --configuration local",
    "production": "ng serve --configuration production",
    "watch": "ng build --watch --configuration development",
    "prebuild": "npm run check:static",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "build:ci": "npm run build -- --stats-json && npm run check:bundle",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/app/**/*.{ts,html}\" --cache --cache-location node_modules/.cache/eslint/ --max-warnings 96",
    "lint:styles": "stylelint \"src/**/*.scss\" --cache --cache-location node_modules/.cache/stylelint/ --max-warnings 22",
    "icons": "node scripts/phosphor-subset.mjs",
    "icons:check": "node scripts/phosphor-subset.mjs --check",
    "check:prod-mocks": "node scripts/check-prod-mocks.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:circular": "madge --circular --ts-config tsconfig.json --extensions ts src/app",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:static": "npm run lint && npm run lint:styles && npm run check:structure && npm run check:styles && npm run check:circular && npm run icons:check && npm run check:prod-mocks",
    "check:fast": "npm run typecheck && npm run check:static",
    "check:stop": "npm run check:fast && ng build",
    "check": "npm run check:fast && npm run test:ci && ng build --stats-json && npm run check:bundle",
    "hooks:install": "node scripts/install-hooks.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "leaflet": "1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular-eslint/eslint-plugin": "^17.5.3",
    "@angular-eslint/eslint-plugin-template": "^17.5.3",
    "@angular-eslint/template-parser": "^17.5.3",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "1.9.12",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^4.2.2",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "madge": "^8.0.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.26.1",
    "stylelint-declaration-strict-value": "^1.13.0",
    "stylelint-scss": "^7.5.0",
    "typescript": "~5.4.2"
  }
}
