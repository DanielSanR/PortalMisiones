# Copiá este archivo a `e2e/.env` (ignorado por git) y completá los valores.
# Los usuarios de prueba de staging están en `backoffice/login.data.md` (local, no versionado)
# o pedíselos al equipo.
E2E_BASE_URL=http://localhost:4200
E2E_PASSWORD=
E2E_SA_EMAIL=
E2E_AB_EMAIL=
E2E_AO_EMAIL=
# Opcionales
# E2E_ALTA_USUARIO=1
