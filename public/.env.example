# ─────────────────────────────────────────────────────────────
# Portal de Trámites de Misiones — Variables de entorno
# Copiar a `.env.local` y ajustar valores.
# ─────────────────────────────────────────────────────────────

# URL pública absoluta del portal (para canonicals, sitemap, JSON-LD).
# En dev podés dejar http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://tramites.misiones.gob.ar

# ─── Data source ─────────────────────────────────────────────
# Mientras la API real no esté lista, dejar en `false` (default).
# Cuando esté lista, cambiar a `true` y completar API_BASE_URL.
NEXT_PUBLIC_USE_API=false

# Base URL de la API del backoffice (sin trailing slash).
# Ejemplo: https://api.tramites.misiones.gob.ar
API_BASE_URL=

# Token server-to-server (Bearer). NO exponer al cliente.
# Opcional: solo si la API lo exige.
API_TOKEN=

# Timeout de requests HTTP a la API (ms). Default 10000.
API_TIMEOUT_MS=10000

# TTL de ISR para responses de la API (segundos). Default 300.
API_REVALIDATE_SECONDS=300

# ─── Revalidación ────────────────────────────────────────────
# Secret compartido con el backoffice para el webhook
# POST /api/revalidate con header `x-revalidate-secret`.
# Sin este valor el endpoint responde 503.
REVALIDATE_SECRET=
